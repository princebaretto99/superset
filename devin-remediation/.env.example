# Copy to .env and fill in, or export these in your shell.

# The repo whose issues get remediated.
TARGET_REPO=princebaretto99/superset

# GitHub token with issues:write on TARGET_REPO (a classic PAT with `repo`,
# or a fine-grained token with Issues: read & write).
GH_TOKEN=ghp_...

# Devin API key from https://app.devin.ai/settings  (apk_... or apk_user_...)
DEVIN_API_KEY=apk_...

# --- optional cost controls (defaults shown) ---
# MAX_ACU=10              # ACU ceiling per Devin session
# MAX_NEW_PER_RUN=3       # new sessions started in a single run
# MAX_IN_FLIGHT=5         # sessions allowed to be running at once
# TIMEOUT_MINUTES=240     # a session older than this is marked failed
# AUTO_NUDGE=true         # nudge a blocked session once before asking a human

# --- only needed for webhook.py ---
# WEBHOOK_SECRET=...      # must match the secret set on the GitHub webhook
# PORT=8080
